-- GÖRSEL BİREBİR ARAYÜZ MİMARİSİ (NEON RED HUB)
-- ====================================================================
local MainGui = Instance.new("ScreenGui")
MainGui.Name = GuiName
MainGui.ResetOnSpawn = false
MainGui.Parent = TargetGuiParent

local MainPanel = Instance.new("Frame")
MainPanel.Size = UDim2.new(0, 720, 0, 420)
MainPanel.Position = UDim2.new(0.5, -360, 0.5, -210)
MainPanel.BackgroundColor3 = THEME.Background
MainPanel.ClipsDescendants = false
MainPanel.Parent = MainGui

Instance.new("UICorner", MainPanel).CornerRadius = UDim.new(0, 10)

local PanelStroke = Instance.new("UIStroke")
PanelStroke.Color = THEME.NeonRed
PanelStroke.Thickness = 2
PanelStroke.Transparency = 0.1
PanelStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
PanelStroke.Parent = MainPanel

-- Glow Loop
task.spawn(function()
	while MainGui and MainGui.Parent do
		TweenService:Create(PanelStroke, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {Transparency = 0.6}):Play()
		task.wait(1.2)
		if not (MainGui and MainGui.Parent) then break end
		TweenService:Create(PanelStroke, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {Transparency = 0.1}):Play()
		task.wait(1.2)
	end
end)

-- SÜRÜKLEME SİSTEMİ
local dragging, dragStart, startPos
Connections.DragBegan = MainPanel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainPanel.Position
	end
end)

Connections.DragEnded = UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

Connections.DragProcess = UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainPanel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- TOP RIGHT CONTROLS
local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 24, 0, 24)
CloseBtn.Position = UDim2.new(1, -32, 0, 10)
CloseBtn.BackgroundTransparency = 1
CloseBtn.Text = "X"
CloseBtn.TextColor3 = THEME.NeonRed
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = MainPanel

CloseBtn.MouseButton1Click:Connect(function()
	pcall(function()
		RunService:UnbindFromRenderStep("EnserAimbot")
	end)

	for _, conn in pairs(Connections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)

	ClearAllESP()
	SendNotification("SİSTEM", "Script kapatıldı.", 2)
	task.wait(0.2)

	if MainGui then MainGui:Destroy() end
	if NotificationGui then NotificationGui:Destroy() end
end)

