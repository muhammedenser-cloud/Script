AddButtonElement(MiscPage, "Server Hop (Başka Sunucuya Geç)", function()
	SendNotification("SERVER HOP", "Uygun sunucu aranıyor...", 2)
	pcall(function()
		local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
		for _, s in ipairs(servers.data) do
			if s.playing < s.maxPlayers and s.id ~= game.JobId then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
				break
			end
		end
	end)
end)

-- 6. CONFIG & UI CATEGORY
AddButtonElement(ConfigPage, "Save Current Config (Ayarları Kaydet)", function()
	pcall(function()
		local encoded = HttpService:JSONEncode(Config)
		writefile(ConfigFolder .. "/default.json", encoded)
		SendNotification("CONFIG", "Ayarlar başarıyla kaydedildi!", 2)
	end)
end)

AddButtonElement(ConfigPage, "Load Saved Config (Ayarları Yükle)", function()
	pcall(function()
		if isfile(ConfigFolder .. "/default.json") then
			local raw = readfile(ConfigFolder .. "/default.json")
			local decoded = HttpService:JSONDecode(raw)
			for k, v in pairs(decoded) do Config[k] = v end
			SendNotification("CONFIG", "Ayarlar başarıyla yüklendi!", 2)
		end
	end)
end)

