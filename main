local function UpdatePreviewWidget()
	local activeList = {}
	for k, v in pairs(States) do
		if v then table.insert(activeList, k:upper()) end
	end

	if #activeList > 0 then
		ActiveDot.BackgroundColor3 = THEME.NeonGreen
		WidgetScriptTitle.Text = activeList[1]
		WidgetScriptTitle.TextColor3 = THEME.NeonGreen
	else
		ActiveDot.BackgroundColor3 = THEME.InactiveText
		WidgetScriptTitle.Text = "NONE"
		WidgetScriptTitle.TextColor3 = THEME.SubText
	end
end

-- CATALOG SCRIPT CARD CREATOR
local function CreateScriptCard(order, titleText, descText, creatorText, stateKey)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -10, 0, 72)
	card.BackgroundColor3 = THEME.CardBg
	card.LayoutOrder = order
	card.Parent = CatalogScroll

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

	local cardStroke = Instance.new("UIStroke")
	cardStroke.Color = THEME.NeonRed
	cardStroke.Thickness = 1
	cardStroke.Transparency = 0.7
	cardStroke.Parent = card

	-- ICON PLACEHOLDER
	local iconFrame = Instance.new("Frame")
	iconFrame.Size = UDim2.new(0, 36, 0, 36)
	iconFrame.Position = UDim2.new(0, 12, 0, 18)
	iconFrame.BackgroundTransparency = 1
	iconFrame.Parent = card

	local iconLbl = Instance.new("TextLabel")
	iconLbl.Size = UDim2.new(1, 0, 1, 0)
	iconLbl.BackgroundTransparency = 1
	iconLbl.Text = "⊕"
	iconLbl.TextColor3 = THEME.NeonRed
	iconLbl.Font = Enum.Font.GothamBold
	iconLbl.TextSize = 22
	iconLbl.Parent = iconFrame

	-- TITLE & DESC
	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(0, 240, 0, 18)
	titleLbl.Position = UDim2.new(0, 56, 0, 8)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = titleText
	titleLbl.TextColor3 = THEME.Text
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 13
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = card

	local descLbl = Instance.new("TextLabel")
	descLbl.Size = UDim2.new(0, 240, 0, 16)
	descLbl.Position = UDim2.new(0, 56, 0, 26)
	descLbl.BackgroundTransparency = 1
	descLbl.Text = descText
	descLbl.TextColor3 = THEME.SubText
	descLbl.Font = Enum.Font.Gotham
	descLbl.TextSize = 10
	descLbl.TextXAlignment = Enum.TextXAlignment.Left
	descLbl.Parent = card

	-- STATUS & CREATOR
	local statusLbl = Instance.new("TextLabel")
	statusLbl.Size = UDim2.new(0, 120, 0, 16)
	statusLbl.Position = UDim2.new(0, 56, 0, 46)
	statusLbl.BackgroundTransparency = 1
	statusLbl.Text = "STATUS: <font color=\"rgb(180, 50, 60)\">INACTIVE</font>"
	statusLbl.RichText = true
	statusLbl.Font = Enum.Font.GothamBold
	statusLbl.TextSize = 10
	statusLbl.TextXAlignment = Enum.TextXAlignment.Left
	statusLbl.Parent = card

	local creatorLbl = Instance.new("TextLabel")
	creatorLbl.Size = UDim2.new(0, 100, 0, 16)
	creatorLbl.Position = UDim2.new(0, 200, 0, 46)
	creatorLbl.BackgroundTransparency = 1
	creatorLbl.Text = "Creator: " .. creatorText
	creatorLbl.TextColor3 = THEME.SubText
	creatorLbl.Font = Enum.Font.Gotham
	creatorLbl.TextSize = 10
	creatorLbl.TextXAlignment = Enum.TextXAlignment.Left
	creatorLbl.Parent = card

	-- LOAD BUTTON
	local loadBtn = Instance.new("TextButton")
	loadBtn.Size = UDim2.new(0, 80, 0, 28)
	loadBtn.Position = UDim2.new(1, -92, 0, 22)
	loadBtn.BackgroundColor3 = THEME.NeonRed
	loadBtn.Text = "LOAD"
	loadBtn.TextColor3 = THEME.Text
	loadBtn.Font = Enum.Font.GothamBold
	loadBtn.TextSize = 11
	loadBtn.Parent = card

	Instance.new("UICorner", loadBtn).CornerRadius = UDim.new(0, 6)

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = THEME.NeonRedGlow
	btnStroke.Thickness = 1
	btnStroke.Parent = loadBtn

	loadBtn.MouseButton1Click:Connect(function()
		States[stateKey] = not States[stateKey]
		local isOn = States[stateKey]

		if isOn then
			statusLbl.Text = "STATUS: <font color=\"rgb(0, 255, 120)\">ACTIVE</font>"
			loadBtn.BackgroundColor3 = THEME.NeonGreen
			loadBtn.Text = "UNLOAD"
			cardStroke.Transparency = 0.2
			cardStroke.Color = THEME.NeonGreen
		else
			statusLbl.Text = "STATUS: <font color=\"rgb(180, 50, 60)\">INACTIVE</font>"
			loadBtn.BackgroundColor3 = THEME.NeonRed
			loadBtn.Text = "LOAD"
			cardStroke.Transparency = 0.7
			cardStroke.Color = THEME.NeonRed
		end

		SendNotification(titleText, (isOn and "Aktif Edildi." or "Devre Dışı."), 1.5)
		UpdatePreviewWidget()

		if stateKey == "SpeedBoost" and not isOn then
			local char = LocalPlayer.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then hum.WalkSpeed = 16 end
			end
		elseif stateKey == "ESP" and not isOn then
			ClearAllESP()
		elseif stateKey == "AutoGun" and isOn then
			CheckForDroppedGuns()
		end
	end)
end

