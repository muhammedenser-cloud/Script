local function CleanupPreviousInstances()
	for _, parent in ipairs({CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}) do
		if parent then
			for _, child in ipairs(parent:GetChildren()) do
				if child.Name == GuiName or child.Name == GuiName .. "_Notif" or child.Name == GuiName .. "_ESP" then
					child:Destroy()
				end
			end
		end
	end
end
CleanupPreviousInstances()

