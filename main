local function SendNotification(title, message, duration)
	duration = duration or 2.5
	local notifCard = Instance.new("Frame")
	notifCard.Size = UDim2.new(1, 0, 0, 55)
	notifCard.BackgroundColor3 = Theme.Card
	notifCard.BackgroundTransparency = 0.1
	notifCard.Parent = NotificationContainer
	Instance.new("UICorner", notifCard).CornerRadius = UDim.new(0, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Accent
	stroke.Thickness = 1.2
	stroke.Parent = notifCard

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -12, 0, 22)
	titleLbl.Position = UDim2.new(0, 10, 0, 5)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = title:upper()
	titleLbl.TextColor3 = Theme.Accent
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 12
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = notifCard

	local msgLbl = Instance.new("TextLabel")
	msgLbl.Size = UDim2.new(1, -12, 0, 22)
	msgLbl.Position = UDim2.new(0, 10, 0, 25)
	msgLbl.BackgroundTransparency = 1
	msgLbl.Text = message
	msgLbl.TextColor3 = Theme.TextMain
	msgLbl.Font = Enum.Font.Gotham
	msgLbl.TextSize = 11
	msgLbl.TextXAlignment = Enum.TextXAlignment.Left
	msgLbl.Parent = notifCard

	local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	notifCard.Position = UDim2.new(1, 300, 0, 0)
	TweenService:Create(notifCard, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)}):Play()

	task.delay(duration, function()
		if notifCard and notifCard.Parent then
			local hideTween = TweenService:Create(notifCard, tweenInfo, {BackgroundTransparency = 1})
			hideTween:Play()
			hideTween.Completed:Connect(function()
				notifCard:Destroy()
			end)
		end
	end)
end

-- ====================================================================================================
-- [SECTION 4] GAME MECHANICS & MM2 ROLE TESPİT SİSTEMİ
-- ====================================================================================================
local function GetPlayerRole(player)
	if not player or not player.Parent then return "Innocent" end
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	local function CheckContainer(container)
		if not container then return nil end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				local itemName = item.Name:lower()
				if itemName == "knife" or item:FindFirstChild("KnifeServer") or item:FindFirstChild("KnifeScript") then
					return "Murderer"
				elseif itemName == "gun" or itemName == "revolver" or item:FindFirstChild("GunServer") or item:FindFirstChild("GunScript") then
					return "Sheriff"
				end
			end
		end
		return nil
	end

	local detectedRole = CheckContainer(character) or CheckContainer(backpack)
	if detectedRole then return detectedRole end

	if Workspace:FindFirstChild("GunDrop") and player:FindFirstChild("HasHeroBadge") then
		return "Hero"
	end

	return "Innocent"
end

local function GetRoleColor(role)
	if role == "Murderer" then
		return Theme.MurdererRed
	elseif role == "Sheriff" then
		return Theme.SheriffBlue
	elseif role == "Hero" then
		return Theme.HeroYellow
	else
		return Theme.InnocentGreen
	end
end

local function HasLineOfSight(originPos, targetPart)
	if not Config.WallCheck then return true end
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	local ignoreList = {LocalPlayer.Character}
	if targetPart and targetPart.Parent then
		table.insert(ignoreList, targetPart.Parent)
	end
	raycastParams.FilterDescendantsInstances = ignoreList
	raycastParams.IgnoreWater = true

	local result = Workspace:Raycast(originPos, targetPart.Position - originPos, raycastParams)
	return result == nil
end

-- ====================================================================================================
-- [SECTION 5] ADVANCED PREDICTIVE AIMBOT & COMBAT ENGINE
-- ====================================================================================================
local function CalculatePredictedPosition(targetPart)
	if not targetPart then return Vector3.zero end
	local velocity = Vector3.zero
	if targetPart:IsA("BasePart") then
		velocity = targetPart.AssemblyLinearVelocity or targetPart.Velocity or Vector3.zero
	end

	local distance = (Camera.CFrame.Position - targetPart.Position).Magnitude
	local bulletSpeed = 350
	local timeOfFlight = distance / bulletSpeed

	return targetPart.Position + (velocity * timeOfFlight * Config.PredictionMultiplier)
end

local function GetClosestTargetForAimbot()
	local mousePos = UserInputService:GetMouseLocation()
	local bestTargetPart = nil
	local minScreenDistance = Config.FOVRadius

	if math.random(1, 100) > Config.HitChance then
		return nil
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
			local targetPart = player.Character:FindFirstChild(Config.HitboxTarget == "Head" and "Head" or "HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and rootPart and targetPart then
				local myRole = GetPlayerRole(LocalPlayer)
				local targetRole = GetPlayerRole(player)
				local isEnemy = false

				if myRole == "Sheriff" or myRole == "Hero" or myRole == "Innocent" then
					if targetRole == "Murderer" then isEnemy = true end
				elseif myRole == "Murderer" then
					isEnemy = true
				end

				if isEnemy then
					local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					if onScreen then
						local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if screenDist <= minScreenDistance then
							local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
							if myRoot and HasLineOfSight(myRoot.Position, targetPart) then
								minScreenDistance = screenDist
								bestTargetPart = targetPart
							end
						end
					end
				end
			end
		end
	end
	return bestTargetPart
end

local function ExecuteCombatLoop(dt)
	-- Silent Aim & Predictive Locking
	if Config.SilentAim then
		local targetPart = GetClosestTargetForAimbot()
		if targetPart then
			local aimPosition = targetPart.Position
			if Config.PredictiveAim then
				aimPosition = CalculatePredictedPosition(targetPart)
			end
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, aimPosition), math.clamp(28 * dt, 0.05, 1))
		end
	end

	-- Sheriff Auto Shoot Logic
	if Config.SheriffAutoShoot and GetPlayerRole(LocalPlayer) == "Sheriff" then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and GetPlayerRole(p) == "Murderer" and p.Character then
				local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
				local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

				if tRoot and myRoot and hum and HasLineOfSight(myRoot.Position, tRoot) then
					local gun = myChar:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")
					if gun then
						if gun.Parent ~= myChar then hum:EquipTool(gun) end
						local predictedPos = Config.PredictiveAim and CalculatePredictedPosition(tRoot) or tRoot.Position
						Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
						gun:Activate()
						VirtualUser:Button1Down(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
						VirtualUser:Button1Up(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
					end
				end
			end
		end
	end

	-- Knife Aura / Kill Aura Logic
	if Config.KnifeAura and GetPlayerRole(LocalPlayer) == "Murderer" then
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

		if myRoot and hum then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local tRoot = p.Character.HumanoidRootPart
					local tHum = p.Character:FindFirstChildOfClass("Humanoid")
					if tHum and tHum.Health > 0 and (tRoot.Position - myRoot.Position).Magnitude <= Config.AuraRadius then
						local knife = myChar:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
						if knife then
							if knife.Parent ~= myChar then hum:EquipTool(knife) end
							knife:Activate()
						end
					end
				end
			end
		end
	end

	-- Auto Grab Gun
	if Config.AutoGrabGun and GetPlayerRole(LocalPlayer) == "Innocent" then
		local gunDrop = Workspace:FindFirstChild("GunDrop")
		if gunDrop then
			local myChar = LocalPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if myRoot then
				if firetouchinterest then
					firetouchinterest(myRoot, gunDrop, 0)
					task.wait(0.01)
					firetouchinterest(myRoot, gunDrop, 1)
				else
					myRoot.CFrame = gunDrop.CFrame + Vector3.new(0, 1, 0)
				end
			end
		end
	end

	-- Kill All Loop Trigger
	if Config.KillAll and GetPlayerRole(LocalPlayer) == "Murderer" then
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local knife = myChar and (myChar:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife"))

		if myRoot and hum and knife then
			if knife.Parent ~= myChar then hum:EquipTool(knife) end
			for _, victim in ipairs(Players:GetPlayers()) do
				if victim ~= LocalPlayer and victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") then
					local vHum = victim.Character:FindFirstChildOfClass("Humanoid")
					if vHum and vHum.Health > 0 then
						myRoot.CFrame = victim.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1.5)
						knife:Activate()
						task.wait(0.12)
					end
				end
			end
		end
		Config.KillAll = false
	end
end

-- ====================================================================================================
-- [SECTION 6] VISUALS & ESP RENDERING ENGINE
-- ====================================================================================================
local function CleanupPlayerESP(playerName)
	if ESPStorage[playerName] then
		pcall(function()
			if ESPStorage[playerName].Highlight then ESPStorage[playerName].Highlight:Destroy() end
			if ESPStorage[playerName].Billboard then ESPStorage[playerName].Billboard:Destroy() end
			if ESPStorage[playerName].Box2D then ESPStorage[playerName].Box2D:Remove() end
			if ESPStorage[playerName].Tracer then ESPStorage[playerName].Tracer:Remove() end
		end)
		ESPStorage[playerName] = nil
	end
end

local function RenderVisualsEngine()
	-- FOV Circle Sync
	if DrawingFOVCircle then
		DrawingFOVCircle.Visible = Config.FOVCircle and Config.SilentAim
		DrawingFOVCircle.Radius = Config.FOVRadius
		DrawingFOVCircle.Color = Config.FOVColor
		DrawingFOVCircle.Position = UserInputService:GetMouseLocation()
	end

	-- World Lighting Adjustments
	if Config.Fullbright then
		Lighting.Brightness = 2.5
		Lighting.ClockTime = Config.TimeOfDay
		Lighting.FogEnd = 1000000
		Lighting.GlobalShadows = false
	elseif Config.RemoveFog then
		Lighting.FogEnd = 1000000
	else
		Lighting.Brightness = OriginalLightingSettings.Brightness
		Lighting.FogEnd = OriginalLightingSettings.FogEnd
		Lighting.GlobalShadows = OriginalLightingSettings.GlobalShadows
	end

	-- Player ESP Processing
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if char and root and hum and hum.Health > 0 then
				local role = GetPlayerRole(player)
				local roleColor = GetRoleColor(role)
				local cache = ESPStorage[player.Name] or {}

				-- Highlighting / Chams
				if Config.Chams then
					if not cache.Highlight or not cache.Highlight.Parent then
						local hl = Instance.new("Highlight")
						hl.Name = "ESP_HL_" .. player.Name
						hl.Parent = TargetGuiParent
						cache.Highlight = hl
					end
					cache.Highlight.Adornee = char
					cache.Highlight.FillColor = roleColor
					cache.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					cache.Highlight.FillTransparency = 0.4
				elseif cache.Highlight then
					cache.Highlight:Destroy()
					cache.Highlight = nil
				end

				-- Billboard Text Info
				if Config.NameESP or Config.RoleESP or Config.DistanceESP or Config.HealthESP then
					if not cache.Billboard or not cache.Billboard.Parent then
						local bb = Instance.new("BillboardGui")
						bb.Name = "ESP_BB_" .. player.Name
						bb.Size = UDim2.new(0, 180, 0, 45)
						bb.AlwaysOnTop = true
						bb.StudsOffset = Vector3.new(0, 3.2, 0)

						local label = Instance.new("TextLabel")
						label.Name = "InfoLabel"
						label.Size = UDim2.new(1, 0, 1, 0)
						label.BackgroundTransparency = 1
						label.Font = Enum.Font.GothamBold
						label.TextSize = 11
						label.TextColor3 = roleColor
						label.TextStrokeTransparency = 0.2
						label.Parent = bb

						bb.Parent = TargetGuiParent
						cache.Billboard = bb
					end

					cache.Billboard.Adornee = root
					local textLbl = cache.Billboard:FindFirstChild("InfoLabel")
					if textLbl then
						local distance = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
						local str = ""
						if Config.NameESP then str = str .. player.DisplayName .. "\n" end
						if Config.RoleESP then str = str .. "[" .. role:upper() .. "] " end
						if Config.HealthESP then str = str .. math.floor(hum.Health) .. " HP " end
						if Config.DistanceESP then str = str .. distance .. " Studs" end
						textLbl.Text = str
						textLbl.TextColor3 = roleColor
					end
				elseif cache.Billboard then
					cache.Billboard:Destroy()
					cache.Billboard = nil
				end

				ESPStorage[player.Name] = cache
			else
				CleanupPlayerESP(player.Name)
			end
		end
	end
end

-- ====================================================================================================
-- [SECTION 7] MOVEMENT & PHYSICS MECHANICS
-- ====================================================================================================
local function ProcessMovementMechanics()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")

	if humanoid then
		if Config.WalkSpeedHack then humanoid.WalkSpeed = Config.WalkSpeedValue end
		if Config.JumpPowerValue then humanoid.JumpPower = Config.JumpPowerValue end
	end

	if Config.CFrameWalk and rootPart and humanoid and humanoid.MoveDirection.Magnitude > 0 then
		rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (Config.CFrameSpeedValue / 4))
	end

	if Config.Noclip and character then
		for _, part in ipairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
end

-- Infinite Jump Request Event
Connections.InfJumpConn = UserInputService.JumpRequest:Connect(function()
	if Config.InfiniteJump and LocalPlayer.Character then
		local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

-- Click Teleport Mechanics
Connections.ClickTPConn = UserInputService.InputBegan:Connect(function(input, gpe)
	if not gpe and Config.ClickTP and input.KeyCode == Config.ClickTPKey then
		local hitPos = Mouse.Hit
		local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if hitPos and rootPart then
			rootPart.CFrame = CFrame.new(hitPos.Position + Vector3.new(0, 3, 0))
			SendNotification("TELEPORT", "Tıklanan noktaya ışınlanıldı.", 1.5)
		end
	end
end)

-- Anti AFK Handler
Connections.AntiAFKConn = LocalPlayer.Idled:Connect(function()
	if Config.AntiAFK then
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.zero)
		SendNotification("ANTI-AFK", "AFK Kalma engellendi.", 2)
	end
end)

-- ====================================================================================================
-- [SECTION 8] AUTO FARM & AUTOMATION MOTORU
-- ====================================================================================================
local function ExecuteAutoFarmEngine()
	if not Config.AutoCoinFarm or GetPlayerRole(LocalPlayer) == "Murderer" then return end
	
	local coinContainer = Workspace:FindFirstChild("CoinContainer", true) or Workspace
	local myChar = LocalPlayer.Character
	local rootPart = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if rootPart and coinContainer then
		for _, item in ipairs(coinContainer:GetChildren()) do
			if item.Name == "Coin" or item.Name == "ServerCoin" then
				local targetCFrame = item.CFrame + (Config.UndergroundFarm and Vector3.new(0, -5.5, 0) or Vector3.zero)
				rootPart.CFrame = targetCFrame
				task.wait(0.18)
				break
			end
		end
	end
end

