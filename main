local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera
local GuiName = "EnserScriptHub_V2"

-- Multi-Container Safe UI Attachment
local TargetGuiParent = LocalPlayer:WaitForChild("PlayerGui")
pcall(function()
	local testGui = Instance.new("ScreenGui")
	testGui.Name = "EnserTestGui"
	testGui.Parent = CoreGui
	testGui:Destroy()
	TargetGuiParent = CoreGui
end)

local function CleanupOldGuis(parent)
	if parent then
		local g = parent:FindFirstChild(GuiName)
		if g then g:Destroy() end
		local n = parent:FindFirstChild(GuiName .. "_Notifications")
		if n then n:Destroy() end
	end
end

CleanupOldGuis(CoreGui)
CleanupOldGuis(LocalPlayer:FindFirstChild("PlayerGui"))

-- ====================================================================
-- KONFİGÜRASYON VE BİREBİR NEON RED TEMA
-- ====================================================================
local THEME = {
	Background = Color3.fromRGB(12, 10, 15),
	SidebarBg = Color3.fromRGB(16, 12, 18),
	CardBg = Color3.fromRGB(20, 14, 22),
	NeonRed = Color3.fromRGB(255, 30, 60),
	NeonRedGlow = Color3.fromRGB(255, 50, 80),
	NeonGreen = Color3.fromRGB(0, 255, 120),
	Text = Color3.fromRGB(240, 240, 255),
	SubText = Color3.fromRGB(140, 140, 160),
	ActiveText = Color3.fromRGB(0, 255, 120),
	InactiveText = Color3.fromRGB(180, 50, 60)
}

local CONFIG = {
	AimbotSpeed = 16,
	AimbotFov = 300,
	KillAuraDistance = 18,
	AutoShootDistance = 85,
	GunTpSpeed = 0.25,
	BulletSpeed = 350,
	KillAuraCooldown = 0.15,
	AutoShootCooldown = 0.4
}

local States = {
	AimBot = false,
	ESP = false,
	SpeedBoost = false,
	AutoShoot = false,
	KillAura = false,
	AutoGun = false
}

local Connections = {}
local EspCache = {}
local lastAuraTime = 0
local lastShootTime = 0
local lastEspUpdate = 0
local isTeleporting = false
local currentActiveTitle = "NONE"

-- ====================================================================
-- BİLDİRİM SİSTEMİ
-- ====================================================================
local NotificationGui = Instance.new("ScreenGui")
NotificationGui.Name = GuiName .. "_Notifications"
NotificationGui.ResetOnSpawn = false
NotificationGui.Parent = TargetGuiParent

local NotifContainer = Instance.new("Frame")
NotifContainer.Size = UDim2.new(0, 240, 1, -20)
NotifContainer.Position = UDim2.new(1, -250, 0, 10)
NotifContainer.BackgroundTransparency = 1
NotifContainer.Parent = NotificationGui

local NotifLayout = Instance.new("UIListLayout")
NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
NotifLayout.Padding = UDim.new(0, 8)
NotifLayout.Parent = NotifContainer

local function SendNotification(title, text, duration)
	if not NotificationGui or not NotificationGui.Parent then return end
	duration = duration or 2.5

	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 48)
	card.BackgroundColor3 = THEME.CardBg
	card.BackgroundTransparency = 1
	card.Parent = NotifContainer

	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

	local stroke = Instance.new("UIStroke")
	stroke.Color = THEME.NeonRed
	stroke.Thickness = 1
	stroke.Transparency = 1
	stroke.Parent = card

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -10, 0, 18)
	titleLbl.Position = UDim2.new(0, 10, 0, 4)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = title
	titleLbl.TextColor3 = THEME.NeonRed
	titleLbl.TextTransparency = 1
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 12
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = card

	local textLbl = Instance.new("TextLabel")
	textLbl.Size = UDim2.new(1, -10, 0, 20)
	textLbl.Position = UDim2.new(0, 10, 0, 22)
	textLbl.BackgroundTransparency = 1
	textLbl.Text = text
	textLbl.TextColor3 = THEME.Text
	textLbl.TextTransparency = 1
	textLbl.Font = Enum.Font.Gotham
	textLbl.TextSize = 11
	textLbl.TextXAlignment = Enum.TextXAlignment.Left
	textLbl.Parent = card

	TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 0.15}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.2}):Play()
	TweenService:Create(titleLbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
	TweenService:Create(textLbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()

	task.delay(duration, function()
		if card and card.Parent then
			local hideTween = TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 1})
			TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
			TweenService:Create(titleLbl, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
			TweenService:Create(textLbl, TweenInfo.new(0.2), {TextTransparency = 1}):Play()

			hideTween:Play()
			hideTween.Completed:Connect(function()
				card:Destroy()
			end)
		end
	end)
end

-- ====================================================================
-- MM2 UTILITIES & ROLE DETECTION
-- ====================================================================
local function IsKnife(item)
	if not item or not item:IsA("Tool") then return false end
	if item.Name == "Knife" or item:FindFirstChild("KnifeServer") or item:FindFirstChild("KnifeScript") then
		return true
	end
	return false
end

local function IsGun(item)
	if not item or not item:IsA("Tool") then return false end
	if item.Name == "Gun" or item.Name == "Revolver" or item:FindFirstChild("GunServer") or item:FindFirstChild("GunScript") then
		return true
	end
	return false
end

local function GetRole(player)
	if not player or not player.Parent then return "Innocent" end
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	if char then
		for _, child in ipairs(char:GetChildren()) do
			if IsKnife(child) then return "Murderer" end
			if IsGun(child) then return "Sheriff" end
		end
	end

	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if IsKnife(child) then return "Murderer" end
			if IsGun(child) then return "Sheriff" end
		end
	end

	return "Innocent"
end

local function HasLineOfSight(originPos, targetPart)
	if not originPos or not targetPart or not targetPart.Parent then return false end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
	rayParams.IgnoreWater = true

	local direction = targetPart.Position - originPos
	local result = Workspace:Raycast(originPos, direction, rayParams)

	return result == nil
end

local function GetPlayerByRole(roleName)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and GetRole(p) == roleName then
			if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					return p
				end
			end
		end
	end
	return nil
end

local function GetClosestTarget(maxDistance)
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, maxDistance end
	local myRoot = myChar.HumanoidRootPart

	local closestPlayer = nil
	local shortestDist = maxDistance or math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestPlayer = p
				end
			end
		end
	end
	return closestPlayer, shortestDist
end

-- ====================================================================
-- ESP SİSTEMİ
-- ====================================================================
local function ClearPlayerESP(plrName)
	if EspCache[plrName] then
		pcall(function()
			if EspCache[plrName].Highlight then EspCache[plrName].Highlight:Destroy() end
			if EspCache[plrName].Billboard then EspCache[plrName].Billboard:Destroy() end
		end)
		EspCache[plrName] = nil
	end
end

local function ClearAllESP()
	for name, _ in pairs(EspCache) do
		ClearPlayerESP(name)
	end
	table.clear(EspCache)
end

local function UpdateESP()
	if not States.ESP then
		ClearAllESP()
		return
	end

	local now = os.clock()
	local updateText = (now - lastEspUpdate) >= 0.05
	if updateText then lastEspUpdate = now end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if char and root and hum and hum.Health > 0 then
				local role = GetRole(p)
				local color = THEME.NeonGreen
				if role == "Murderer" then
					color = THEME.NeonRed
				elseif role == "Sheriff" then
					color = Color3.fromRGB(0, 150, 255)
				end

				local cacheData = EspCache[p.Name] or {}

				if cacheData.LastChar ~= char then
					ClearPlayerESP(p.Name)
					cacheData = {}
				end

				if not cacheData.Highlight or not cacheData.Highlight.Parent then
					local hl = Instance.new("Highlight")
					hl.Name = "ESP_HL_" .. p.Name
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0.1
					hl.Parent = TargetGuiParent
					cacheData.Highlight = hl
				end
				cacheData.Highlight.Adornee = char
				cacheData.Highlight.FillColor = color
				cacheData.Highlight.OutlineColor = color

				if not cacheData.Billboard or not cacheData.Billboard.Parent then
					local bb = Instance.new("BillboardGui")
					bb.Name = "ESP_BB_" .. p.Name
					bb.Size = UDim2.new(0, 150, 0, 30)
					bb.AlwaysOnTop = true
					bb.StudsOffset = Vector3.new(0, 3, 0)

					local lbl = Instance.new("TextLabel")
					lbl.Name = "InfoLabel"
					lbl.Size = UDim2.new(1, 0, 1, 0)
					lbl.BackgroundTransparency = 1
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 11
					lbl.Parent = bb

					bb.Parent = TargetGuiParent
					cacheData.Billboard = bb
				end

				cacheData.Billboard.Adornee = root

				if updateText then
					local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
					local infoLbl = cacheData.Billboard:FindFirstChild("InfoLabel")
					if infoLbl then
						infoLbl.Text = string.format("%s\n[%s] - %dm", p.Name, role:upper(), dist)
						infoLbl.TextColor3 = color
					end
				end

				cacheData.LastChar = char
				EspCache[p.Name] = cacheData
			else
				ClearPlayerESP(p.Name)
			end
		end
	end
end

-- ====================================================================
-- COMBAT MOTORU
-- ====================================================================
local function ProcessAimbot(dt)
	if not States.AimBot then return end

	local myRole = GetRole(LocalPlayer)
	local targetPlayer = nil

	if myRole == "Sheriff" or myRole == "Innocent" then
		targetPlayer = GetPlayerByRole("Murderer")
	elseif myRole == "Murderer" then
		targetPlayer, _ = GetClosestTarget(250)
	end

	if targetPlayer and targetPlayer.Character then
		local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		if targetRoot then
			local screenPos, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
			if onScreen then
				local mousePos = UserInputService:GetMouseLocation()
				local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

				if fovDist <= CONFIG.AimbotFov then
					local dist = (Camera.CFrame.Position - targetRoot.Position).Magnitude
					local timeToTarget = dist / CONFIG.BulletSpeed
					local predictedPos = targetRoot.Position + (targetRoot.Velocity * timeToTarget)
					local camPos = Camera.CFrame.Position

					if (camPos - predictedPos).Magnitude > 0.1 then
						local targetCFrame = CFrame.lookAt(camPos, predictedPos)
						local lerpFactor = 1 - math.exp(-CONFIG.AimbotSpeed * dt)
						Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(lerpFactor, 0.01, 1))
					end
				end
			end
		end
	end
end

local function ProcessKillAura()
	if not States.KillAura or GetRole(LocalPlayer) ~= "Murderer" then return end
	local now = os.clock()
	if now - lastAuraTime < CONFIG.KillAuraCooldown then return end

	local myChar = LocalPlayer.Character
	if not myChar then return end
	local hum = myChar:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local knife = nil

	for _, item in ipairs(myChar:GetChildren()) do
		if IsKnife(item) then knife = item break end
	end
	if not knife and backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if IsKnife(item) then knife = item break end
		end
	end

	if knife then
		local target, dist = GetClosestTarget(CONFIG.KillAuraDistance)
		if target and dist <= CONFIG.KillAuraDistance then
			lastAuraTime = now
			if knife.Parent ~= myChar then
				hum:EquipTool(knife)
				task.wait(0.04)
			end
			knife:Activate()
		end
	end
end

local function ProcessAutoShoot()
	if not States.AutoShoot or GetRole(LocalPlayer) ~= "Sheriff" then return end
	local now = os.clock()
	if now - lastShootTime < CONFIG.AutoShootCooldown then return end

	local myChar = LocalPlayer.Character
	if not myChar then return end
	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local hum = myChar:FindFirstChildOfClass("Humanoid")
	if not myRoot or not hum or hum.Health <= 0 then return end

	local murderer = GetPlayerByRole("Murderer")
	if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
		local targetRoot = murderer.Character.HumanoidRootPart
		local dist = (myRoot.Position - targetRoot.Position).Magnitude

		if dist <= CONFIG.AutoShootDistance then
			if HasLineOfSight(myRoot.Position, targetRoot) then
				local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
				local gun = nil

				for _, item in ipairs(myChar:GetChildren()) do
					if IsGun(item) then gun = item break end
				end
				if not gun and backpack then
					for _, item in ipairs(backpack:GetChildren()) do
						if IsGun(item) then gun = item break end
					end
				end

				if gun then
					lastShootTime = now
					if gun.Parent ~= myChar then
						hum:EquipTool(gun)
						task.wait(0.04)
					end

					local timeToTarget = dist / CONFIG.BulletSpeed
					local predictedPos = targetRoot.Position + (targetRoot.Velocity * timeToTarget)
					Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predictedPos)

					task.spawn(function()
						gun:Activate()
						local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
						VirtualUser:Button1Down(center)
						VirtualUser:Button1Up(center)
					end)
				end
			end
		end
	end
end

-- ====================================================================
-- AUTO GUN TP
-- ====================================================================
local function TeleportToGun(gunDrop)
	if isTeleporting or not States.AutoGun then return end
	if GetRole(LocalPlayer) ~= "Innocent" then return end

	local myChar = LocalPlayer.Character
	local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end

	local targetPart = gunDrop:IsA("BasePart") and gunDrop or gunDrop:FindFirstChild("Handle") or gunDrop:FindFirstChildWhichIsA("BasePart")
	if targetPart and targetPart:IsDescendantOf(Workspace) then
		isTeleporting = true

		local touchTransmitter = targetPart:FindFirstChildWhichIsA("TouchTransmitter", true) or targetPart
		if firetouchinterest and root and targetPart then
			SendNotification("AUTO GUN", "Silah çantaya alındı.", 2)
			pcall(function()
				firetouchinterest(root, touchTransmitter, 0)
				task.wait(0.02)
				firetouchinterest(root, touchTransmitter, 1)
			end)
			isTeleporting = false
			return
		end

		SendNotification("AUTO GUN", "Silaha ışınlanılıyor...", 2)
		local originalCFrame = root.CFrame

		task.spawn(function()
			if not targetPart or not targetPart.Parent then 
				isTeleporting = false 
				return 
			end

			local targetCFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
			local tweenInfo = TweenInfo.new(CONFIG.GunTpSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
			tween:Play()
			tween.Completed:Wait()

			task.wait(0.12)
			if root and root.Parent and States.AutoGun and hum.Health > 0 then
				local returnTween = TweenService:Create(root, tweenInfo, {CFrame = originalCFrame})
				returnTween:Play()
				returnTween.Completed:Wait()
			end
			isTeleporting = false
		end)
	end
end

local function CheckForDroppedGuns()
	if not States.AutoGun then return end
	for _, child in ipairs(Workspace:GetChildren()) do
		if child.Name == "GunDrop" or IsGun(child) then
			TeleportToGun(child)
			break
		end
	end
end

Connections.WorkspaceChildAdded = Workspace.ChildAdded:Connect(function(child)
	if child.Name == "GunDrop" or IsGun(child) then
		task.wait(0.08)
		TeleportToGun(child)
	end
end)

Connections.SpeedEnforcer = RunService.Heartbeat:Connect(function()
	if States.SpeedBoost then
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.WalkSpeed ~= 22 then
				hum.WalkSpeed = 22
			end
		end
	end
end)

