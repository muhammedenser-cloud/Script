local TabPages = {}

local function CreateTab(tabName, tabIcon)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(1, 0, 0, 36)
	tabBtn.BackgroundColor3 = Theme.Card
	tabBtn.BackgroundTransparency = 1
	tabBtn.Text = "   " .. tabIcon .. "  " .. tabName
	tabBtn.TextColor3 = Theme.TextSub
	tabBtn.Font = Enum.Font.GothamBold
	tabBtn.TextSize = 11
	tabBtn.TextXAlignment = Enum.TextXAlignment.Left
	tabBtn.Parent = TabButtonContainer
	Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

	local pageScroll = Instance.new("ScrollingFrame")
	pageScroll.Size = UDim2.new(1, 0, 1, 0)
	pageScroll.BackgroundTransparency = 1
	pageScroll.ScrollBarThickness = 3
	pageScroll.ScrollBarImageColor3 = Theme.Accent
	pageScroll.Visible = false
	pageScroll.Parent = ContentArea

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Padding = UDim.new(0, 8)
	pageLayout.Parent = pageScroll

	tabBtn.MouseButton1Click:Connect(function()
		for _, tabData in pairs(TabPages) do
			tabData.Button.BackgroundTransparency = 1
			tabData.Button.TextColor3 = Theme.TextSub
			tabData.Page.Visible = false
		end
		tabBtn.BackgroundTransparency = 0
		tabBtn.TextColor3 = Theme.Accent
		pageScroll.Visible = true
	end)

	local tabData = { Button = tabBtn, Page = pageScroll, Layout = pageLayout }
	TabPages[tabName] = tabData
	return pageScroll
end

-- GUI COMPONENT BUILDERS (TOGGLES, SLIDERS, BUTTONS)
local function AddToggleElement(parentPage, textLabelText, configKey, callback)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -10, 0, 42)
	card.BackgroundColor3 = Theme.Card
	card.Parent = parentPage
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 320, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = textLabelText
	label.TextColor3 = Theme.TextMain
	label.Font = Enum.Font.GothamBold
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = card

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 70, 0, 24)
	toggleBtn.Position = UDim2.new(1, -80, 0.5, -12)
	toggleBtn.BackgroundColor3 = Config[configKey] and Theme.InnocentGreen or Theme.MurdererRed
	toggleBtn.Text = Config[configKey] and "ON" or "OFF"
	toggleBtn.TextColor3 = Theme.TextMain
	toggleBtn.Font = Enum.Font.GothamBold
	toggleBtn.TextSize = 10
	toggleBtn.Parent = card
	Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

	toggleBtn.MouseButton1Click:Connect(function()
		Config[configKey] = not Config[configKey]
		toggleBtn.BackgroundColor3 = Config[configKey] and Theme.InnocentGreen or Theme.MurdererRed
		toggleBtn.Text = Config[configKey] and "ON" or "OFF"
		SendNotification(textLabelText, Config[configKey] and "Aktif Edildi" or "Devre Dışı", 1.5)
		if callback then callback(Config[configKey]) end
	end)
end

local function AddSliderElement(parentPage, textLabelText, configKey, minVal, maxVal, callback)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -10, 0, 50)
	card.BackgroundColor3 = Theme.Card
	card.Parent = parentPage
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -20, 0, 20)
	label.Position = UDim2.new(0, 12, 0, 4)
	label.BackgroundTransparency = 1
	label.Text = textLabelText .. ": " .. tostring(Config[configKey])
	label.TextColor3 = Theme.TextMain
	label.Font = Enum.Font.GothamBold
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = card

	local sliderBg = Instance.new("Frame")
	sliderBg.Size = UDim2.new(1, -24, 0, 8)
	sliderBg.Position = UDim2.new(0, 12, 0, 30)
	sliderBg.BackgroundColor3 = Theme.Sidebar
	sliderBg.Parent = card
	Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(0, 4)

	local sliderFill = Instance.new("Frame")
	local initPercent = math.clamp((Config[configKey] - minVal) / (maxVal - minVal), 0, 1)
	sliderFill.Size = UDim2.new(initPercent, 0, 1, 0)
	sliderFill.BackgroundColor3 = Theme.Accent
	sliderFill.Parent = sliderBg
	Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 4)

	local dragging = false
	local function UpdateSlider(input)
		local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
		local val = math.floor(minVal + (maxVal - minVal) * pos)
		Config[configKey] = val
		sliderFill.Size = UDim2.new(pos, 0, 1, 0)
		label.Text = textLabelText .. ": " .. tostring(val)
		if callback then callback(val) end
	end

	sliderBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			UpdateSlider(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			UpdateSlider(input)
		end
	end)
end

local function AddButtonElement(parentPage, buttonText, callback)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -10, 0, 40)
	card.BackgroundColor3 = Theme.Card
	card.Parent = parentPage
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 1, -10)
	btn.Position = UDim2.new(0, 10, 0, 5)
	btn.BackgroundColor3 = Theme.Sidebar
	btn.Text = buttonText
	btn.TextColor3 = Theme.Accent
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.Parent = card
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

	btn.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
end

