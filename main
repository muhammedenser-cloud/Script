CreateScriptCard(2, "ESP & WALLHACK [v1.5]", "ESP & wallhack for streams and infinite machine.", "Noma", "ESP")
CreateScriptCard(3, "SPEED HACK [v2.2]", "Speed hack is emmmond to speing.", "Kadrar", "SpeedBoost")
CreateScriptCard(4, "AUTO SHOOT (SHERIFF) [v2.0]", "Auto shoots murderer with line of sight check.", "Enser", "AutoShoot")
CreateScriptCard(5, "KILL AURA (MURDER) [v1.8]", "Automatic knife aura for innocent team.", "Enser", "KillAura")
CreateScriptCard(6, "AUTO GUN TP [v1.2]", "Instantly picks up dropped sheriff gun.", "Rian", "AutoGun")

